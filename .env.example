# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=movie_dw

# OMDb API Configuration
# Get your free key at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Pipeline Settings
# Number of movies to enrich with OMDb API in a run.
# Free OMDb API key has a limit of 1,000 requests/day.
# Set to 100 for quick testing, or leave empty/0 to enrich all available or cached movies.
OMDB_FETCH_LIMIT=100

